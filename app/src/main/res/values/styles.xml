<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CpIPOSNative" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Launch-only theme: existing owner-provided blue CpIPOS symbol. -->
    <style name="Theme.CpIPOSNative.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/native_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cpipos_receipt_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CpIPOSNative</item>
    </style>
</resources>
